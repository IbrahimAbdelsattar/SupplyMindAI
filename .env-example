# ==============================================================================
# SupplyMind AI — Environment Reference Template
# ==============================================================================

# ══════════════════════════════════════════════════════════════════════════════
# APPLICATION ENVIRONMENT
# ══════════════════════════════════════════════════════════════════════════════
ENVIRONMENT=development

# ══════════════════════════════════════════════════════════════════════════════
# DATABASE
# ══════════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://postgres.zjugkebpmiworbxcrjrm:[YOUR_SUPABASE_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_USER=supplymind
POSTGRES_PASSWORD=password
POSTGRES_DB=supplymind
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_CONNECT_TIMEOUT=10
DB_POOL_TIMEOUT=30
REDIS_URL=redis://redis:6379

# ══════════════════════════════════════════════════════════════════════════════
# SECURITY & CORS
# ══════════════════════════════════════════════════════════════════════════════
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Clerk JWKS verification — required for backend JWT verification
# Backend uses this to extract the Clerk domain for JWKS key fetching
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
# Clerk secret key — used by backend for API calls (optional for JWT verification)
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# ══════════════════════════════════════════════════════════════════════════════
# LLM / AI PROVIDERS (OmniRoute AI Gateway)
# ══════════════════════════════════════════════════════════════════════════════
LLM_PROVIDER=omniroute
OMNIROUTE_API_KEY=sk-omni-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OMNIROUTE_BASE_URL=https://omniroute.wajehni-ai.space/v1
LLM_BASE_URL=https://omniroute.wajehni-ai.space/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Agent-Specific Overrides (Optional — each agent can get model, base_url, and api_key from env)
# INVENTORY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# INVENTORY_BASE_URL=https://omniroute.wajehni-ai.space/v1
# INVENTORY_API_KEY=sk-omni-xxxxxxxxxxxxxxxx
# FORECAST_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# FORECAST_BASE_URL=https://omniroute.wajehni-ai.space/v1
# FORECAST_API_KEY=sk-omni-xxxxxxxxxxxxxxxx
# SUPPORT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# SUPPORT_BASE_URL=https://omniroute.wajehni-ai.space/v1
# SUPPORT_API_KEY=sk-omni-xxxxxxxxxxxxxxxx
# INSIGHTS_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# INSIGHTS_BASE_URL=https://omniroute.wajehni-ai.space/v1
# INSIGHTS_API_KEY=sk-omni-xxxxxxxxxxxxxxxx
# REPORT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# REPORT_BASE_URL=https://omniroute.wajehni-ai.space/v1
# REPORT_API_KEY=sk-omni-xxxxxxxxxxxxxxxx
# SECURITY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# SECURITY_BASE_URL=https://omniroute.wajehni-ai.space/v1
# SECURITY_API_KEY=sk-omni-xxxxxxxxxxxxxxxx
# COPILOT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# COPILOT_BASE_URL=https://omniroute.wajehni-ai.space/v1
# COPILOT_API_KEY=sk-omni-xxxxxxxxxxxxxxxx
# DOCUMENTATION_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# DOCUMENTATION_BASE_URL=https://omniroute.wajehni-ai.space/v1
# DOCUMENTATION_API_KEY=sk-omni-xxxxxxxxxxxxxxxx
# INTENT_DETECTOR_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# INTENT_DETECTOR_BASE_URL=https://omniroute.wajehni-ai.space/v1
# INTENT_DETECTOR_API_KEY=sk-omni-xxxxxxxxxxxxxxxx

# Fallback compatibility keys (optional)
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Feature Flags
ENABLE_COPILOT=true
ENABLE_RAG=true
ENABLE_AI_INSIGHTS=true
ENABLE_FORECAST_INSIGHTS=true
RESTRICT_CHATBOT=true # If true, forces chatbot to only act as customer support, restricting business data/technical code access.

# ══════════════════════════════════════════════════════════════════════════════
# EMBEDDINGS & VECTORS
# ══════════════════════════════════════════════════════════════════════════════
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
KNOWLEDGE_MATCH_THRESHOLD=0.45
KNOWLEDGE_MATCH_COUNT=8
KNOWLEDGE_BATCH_EMBED_SIZE=32
KNOWLEDGE_INGESTION_ASYNC=true
RAG_WARM_UP_ON_STARTUP=false

# ══════════════════════════════════════════════════════════════════════════════
# LANGCHAIN / LANGSMITH OBSERVABILITY
# ══════════════════════════════════════════════════════════════════════════════
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=supplymind-dev
COPILOT_USE_LANGGRAPH=true

# ══════════════════════════════════════════════════════════════════════════════
# MODELING, MLOps & STORAGE
# ══════════════════════════════════════════════════════════════════════════════
MODEL_PATH=./Modeling/demand_model_pipeline.pkl
FORECAST_CSV_PATH=./Modeling/future_forecast.csv
DRIFT_THRESHOLD=0.05
STORAGE_PATH=./data/storage
LOG_LEVEL=DEBUG

# ══════════════════════════════════════════════════════════════════════════════
# FRONTEND
# ══════════════════════════════════════════════════════════════════════════════
VITE_API_URL=http://localhost:8081/api/v1
# Clerk publishable key for frontend (Vite inlines this at BUILD time)
# MUST match the domain used in CLERK_PUBLISHABLE_KEY above
# Dev: pk_test_xxx  |  Prod: pk_live_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE


# ══════════════════════════════════════════════════════════════════════════════
# PRODUCTION DEPLOYMENT (docker-compose.prod.yml)
# ══════════════════════════════════════════════════════════════════════════════
# These are required when deploying with docker-compose.prod.yml.
# Set REDIS_PASSWORD to a strong random value.
REDIS_PASSWORD=change-me-to-a-strong-password

# Docker images (set to your registry path)
BACKEND_IMAGE=supplymind-backend:latest
FRONTEND_IMAGE=supplymind-frontend:latest
WORKER_IMAGE=supplymind-worker:latest

# LLM API key (no default in production — must be set)
OMNIROUTE_API_KEY=sk-omni-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OMNIROUTE_BASE_URL=https://omniroute.wajehni-ai.space/v1
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
