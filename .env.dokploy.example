# ==============================================================================
# SupplyMind AI — Dokploy Environment Configuration Template
# ==============================================================================
# Paste these variables directly into the "Environment" tab of your
# Compose Service in Dokploy.
# ==============================================================================

# ── DOMAIN & NETWORK ─────────────────────────────────────────────────────────
# The domain pointing to your VPS in DNS (A record -> VPS IP)
DOMAIN=supplymind.yourdomain.com
ALLOWED_ORIGINS=https://supplymind.yourdomain.com,http://localhost
ALLOWED_HOSTS=*

# ── APPLICATION ENVIRONMENT ──────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ── DATABASE & CACHE PASSWORDS ───────────────────────────────────────────────
# Choose secure random strings for your production database and redis
POSTGRES_USER=supplymind_prod
POSTGRES_PASSWORD=generate-a-strong-postgres-password-here
POSTGRES_DB=supplymind_prod
REDIS_PASSWORD=generate-a-strong-redis-password-here

# ── AUTHENTICATION & SECRETS ─────────────────────────────────────────────────
# 32+ character random string for self-hosted JWT token signing
JWT_SECRET_KEY=generate-a-secure-random-jwt-secret-key-32chars

# Clerk Authentication (if using Clerk; otherwise JWT self-hosted auth is active)
CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET_KEY_HERE
CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY_HERE
VITE_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY_HERE
VITE_API_URL=/api/v1

# ── LLM & AI GATEWAY (OmniRoute) ─────────────────────────────────────────────
# OmniRoute is the primary AI gateway
LLM_PROVIDER=omniroute
OMNIROUTE_API_KEY=your-omniroute-api-key-here
OMNIROUTE_BASE_URL=https://omniroute.wajehni-ai.space/v1
LLM_BASE_URL=https://omniroute.wajehni-ai.space/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── OPTIONAL PER-AGENT OVERRIDES ─────────────────────────────────────────────
# Each agent can independently override model, base_url, or api_key:
# INVENTORY_MODEL=
# INVENTORY_BASE_URL=https://omniroute.wajehni-ai.space/v1
# INVENTORY_API_KEY=
# FORECAST_MODEL=
# FORECAST_BASE_URL=https://omniroute.wajehni-ai.space/v1
# FORECAST_API_KEY=
# SUPPORT_MODEL=
# SUPPORT_BASE_URL=https://omniroute.wajehni-ai.space/v1
# SUPPORT_API_KEY=
# INSIGHTS_MODEL=
# INSIGHTS_BASE_URL=https://omniroute.wajehni-ai.space/v1
# INSIGHTS_API_KEY=

# ── PLATFORM FEATURE FLAGS ───────────────────────────────────────────────────
ENABLE_COPILOT=true
ENABLE_RAG=true
ENABLE_AI_INSIGHTS=true
ENABLE_FORECAST_INSIGHTS=true
RESTRICT_CHATBOT=true

# ── EMBEDDINGS & VECTOR KNOWLEDGE BASE ───────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
KNOWLEDGE_MATCH_THRESHOLD=0.45
KNOWLEDGE_MATCH_COUNT=8
KNOWLEDGE_BATCH_EMBED_SIZE=32
KNOWLEDGE_INGESTION_ASYNC=true
RAG_WARM_UP_ON_STARTUP=false
STORAGE_PATH=/app/data/storage

# ── OBSERVABILITY (Optional - LangSmith) ──────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=supplymind-production
